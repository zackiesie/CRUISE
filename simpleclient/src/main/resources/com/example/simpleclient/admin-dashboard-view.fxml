<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simpleclient.AdminDashboardController"><content><VBox spacing="22" styleClass="admin-page"><padding><Insets top="36" right="42" bottom="50" left="42"/></padding><HBox alignment="CENTER_LEFT"><VBox><Label text="Operations Dashboard" styleClass="admin-page-title"/><Label fx:id="dashboardStatusLabel" text="Loading..." styleClass="admin-page-subtitle"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refreshDashboard" styleClass="admin-primary-button"/></HBox>
<HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="dash-stat-card"><Label text="FLEET" styleClass="dash-stat-label"/><Label fx:id="totalCarsLabel" text="—" styleClass="dash-stat-value"/><Label text="total vehicles" styleClass="dash-stat-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="dash-stat-card"><Label text="CUSTOMERS" styleClass="dash-stat-label"/><Label fx:id="totalCustomersLabel" text="—" styleClass="dash-stat-value"/><Label text="registered renters" styleClass="dash-stat-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="dash-stat-card"><Label text="BOOKINGS" styleClass="dash-stat-label"/><Label fx:id="totalBookingsLabel" text="—" styleClass="dash-stat-value"/><Label text="all reservations" styleClass="dash-stat-note"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="dash-stat-card"><Label text="PAID REVENUE" styleClass="dash-stat-label"/><Label fx:id="revenueLabel" text="—" styleClass="dash-stat-value"/><Label text="current paid value" styleClass="dash-stat-note"/></VBox></HBox>
<HBox spacing="12"><VBox HBox.hgrow="ALWAYS" styleClass="admin-insight-card"><Label text="AVAILABLE NOW" styleClass="dash-stat-label"/><Label fx:id="availableCarsLabel" text="—" styleClass="admin-insight-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="admin-insight-card"><Label text="UNAVAILABLE" styleClass="dash-stat-label"/><Label fx:id="unavailableCarsLabel" text="—" styleClass="admin-insight-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="admin-insight-card"><Label text="ACTIVE RENTALS" styleClass="dash-stat-label"/><Label fx:id="activeRentalsLabel" text="—" styleClass="admin-insight-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="admin-insight-card"><Label text="MAINTENANCE" styleClass="dash-stat-label"/><Label fx:id="maintenanceCarsLabel" text="—" styleClass="admin-insight-value"/></VBox></HBox>
<VBox spacing="8" styleClass="report-hero"><Label text="CONTROL CENTRE" styleClass="dash-eyebrow"/><Label text="Everything your fleet needs. One workspace." wrapText="true" styleClass="dash-booking-title"/><Label text="Use the navigation to manage cars, review customer reservations, inspect registered customers and view business reports." wrapText="true" styleClass="admin-page-subtitle"/></VBox>
</VBox></content></ScrollPane>
