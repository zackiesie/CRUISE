<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" stylesheets="@styles.css" styleClass="customer-page-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" id="page-bookings" fx:controller="com.example.simpleclient.BookingDetailsController">
<content><VBox spacing="22" styleClass="customer-page"><padding><Insets top="38" right="50" bottom="55" left="50"/></padding>
<HBox alignment="CENTER_LEFT"><Button text="← My Bookings" onAction="#backToBookings" styleClass="dash-link-button"/><Region HBox.hgrow="ALWAYS"/><Button text="Save receipt" onAction="#saveReceipt" styleClass="dash-secondary-button"/><Button text="Dashboard" onAction="#backToDashboard" styleClass="dash-secondary-button"/></HBox>
<VBox spacing="8"><Label text="TRIP DETAILS" styleClass="dash-eyebrow"/><Label fx:id="idLabel" text="Booking" styleClass="dash-hero-title"/><Label text="Your complete reservation and payment summary." styleClass="dash-hero-subtitle"/></VBox>
<HBox spacing="14"><VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="booking-detail-highlight"><Label text="RENTAL STATUS" styleClass="dash-stat-label"/><Label fx:id="statusLabel" text="—" styleClass="booking-detail-big"/></VBox><VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="booking-detail-highlight"><Label text="PAYMENT" styleClass="dash-stat-label"/><Label fx:id="paymentLabel" text="—" styleClass="booking-detail-big"/></VBox><VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="booking-detail-highlight"><Label text="TOTAL" styleClass="dash-stat-label"/><Label fx:id="totalLabel" text="—" styleClass="booking-detail-big"/></VBox></HBox>
<VBox spacing="18" styleClass="booking-detail-card"><Label text="Rental summary" styleClass="dash-booking-title"/><GridPane hgap="30" vgap="16"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><Label text="Rental dates" styleClass="detail-key" GridPane.rowIndex="0"/><Label fx:id="datesLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/><Label text="Duration" styleClass="detail-key" GridPane.rowIndex="1"/><Label fx:id="durationLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="Vehicle" styleClass="detail-key" GridPane.rowIndex="2"/><Label fx:id="carIdLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/></GridPane></VBox>
<VBox spacing="18" styleClass="booking-detail-card"><Label text="Booking journey" styleClass="dash-booking-title"/><HBox spacing="10" alignment="CENTER_LEFT"><Label text="✓ Reserved" styleClass="timeline-step"/><Label text="→" styleClass="timeline-arrow"/><Label text="✓ Paid" styleClass="timeline-step"/><Label text="→" styleClass="timeline-arrow"/><Label fx:id="timelineRentalLabel" text="Rental active" styleClass="timeline-step"/><Label text="→" styleClass="timeline-arrow"/><Label fx:id="timelineReturnLabel" text="Return" styleClass="timeline-step"/></HBox></VBox>
<VBox spacing="18" styleClass="booking-detail-card"><Label text="Price &amp; extras" styleClass="dash-booking-title"/><GridPane hgap="30" vgap="14"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><Label text="Base rental" styleClass="detail-key"/><Label fx:id="baseAmountLabel" styleClass="detail-value" GridPane.columnIndex="1"/><Label text="Add-ons" styleClass="detail-key" GridPane.rowIndex="1"/><Label fx:id="addonsLabel" wrapText="true" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="Protection" styleClass="detail-key" GridPane.rowIndex="2"/><Label fx:id="protectionLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/><Label text="Extras total" styleClass="detail-key" GridPane.rowIndex="3"/><Label fx:id="addonAmountLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/></GridPane></VBox>
<VBox spacing="18" styleClass="booking-detail-card"><Label text="Return record" styleClass="dash-booking-title"/><Label fx:id="returnLabel" text="Return details will appear here after the rental is completed." wrapText="true" styleClass="dash-hero-subtitle"/></VBox>
<VBox spacing="18" styleClass="booking-detail-card"><Label text="Renter information" styleClass="dash-booking-title"/><GridPane hgap="30" vgap="16"><columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints><Label text="Name" styleClass="detail-key"/><Label fx:id="customerLabel" styleClass="detail-value" GridPane.columnIndex="1"/><Label text="Email" styleClass="detail-key" GridPane.rowIndex="1"/><Label fx:id="emailLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="Phone" styleClass="detail-key" GridPane.rowIndex="2"/><Label fx:id="phoneLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/></GridPane></VBox>
</VBox></content></ScrollPane>
