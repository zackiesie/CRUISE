# Copy to .env and fill in locally. scripts/run.ps1 loads this file.
# Direct Java/NetBeans launches still read OS environment variables.
# Optional if the default Java is older than 21 (use your own installed JDK path):
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\YOUR_JDK_21_FOLDER
DB_URL=jdbc:mysql://localhost:3306/simpleapi_db
DB_USERNAME=root
DB_PASSWORD=

STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_DESKTOP_CLIENT_ID=REPLACE_ME
GOOGLE_DESKTOP_CLIENT_SECRET=REPLACE_ME

CRUISE_ADMIN_USERNAME=admin
CRUISE_ADMIN_PASSWORD=CHANGE_ME
